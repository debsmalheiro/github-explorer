# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files that should always have LF line endings
*.tsx text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Declare files that will always have CRLF line endings on checkout (Windows specific)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Node modules
node_modules/ text eol=lf

# Package manager files
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary
